{
  "manifest_version": 3,
  "name": "Peek",
  "version": "0.2.2",
  "description": "Point at a page element and send it \u2014 selector, DOM, and a cropped screenshot \u2014 to your coding agent.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Peek \u2014 pick an element (Alt+Shift+P)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "commands",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-picker": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Toggle the Peek element picker"
    }
  }
}
