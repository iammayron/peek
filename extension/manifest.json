{
  "manifest_version": 3,
  "name": "InspectAI",
  "version": "0.1.0",
  "description": "Point at a page element and send it — selector, DOM, and a cropped screenshot — to your coding agent.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "InspectAI — pick an element (Alt+Shift+I)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": ["nativeMessaging", "activeTab", "tabs", "scripting", "commands", "alarms"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "toggle-picker": {
      "suggested_key": {
        "default": "Alt+Shift+I",
        "mac": "Alt+Shift+I"
      },
      "description": "Toggle the InspectAI element picker"
    }
  }
}
